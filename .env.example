# ---------------------------------------------------------------------------
# nas-llm environment. Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# NAS SSH access (used by scripts/deploy.sh and scripts/pull-models.sh).
NAS_HOST=192.168.1.50
NAS_USER=root

# Docker data volume on the NAS. Put model weights on the NVMe drive.
# Determine this in phase 1 by running `df -h` over SSH:
#   - /volume1  if the NVMe is folded into volume1
#   - /volume2  if the NVMe is its own volume
DOCKER_VOLUME=/volume1

# Cloudflare Tunnel token (phase 4). Leave blank until you create the named
# tunnel in the Cloudflare dashboard. deploy.sh only starts cloudflared when
# this is non-empty (via the `tunnel` compose profile).
TUNNEL_TOKEN=

# API bearer token. Generate with:  openssl rand -hex 32
# Use hex only — other characters can break the Caddyfile matcher.
API_BEARER_TOKEN=replace-with-openssl-rand-hex-32

# Model + tuning (phase 3).
OLLAMA_MODEL=llama3.2:3b
# Context length in tokens. The KV cache is what costs RAM and per-token time
# on 8 GB, so prefer a smaller context over a bigger model. 8192 is a good
# default for a 3B chat; docker-compose falls back to 16384 when this is unset,
# so keep it explicit here. Give the web_search 8B a shorter context (~8192)
# and keep the 3B at this value. This value is also read by the backend (via
# docker-compose) to estimate per-model KV-cache RAM in the model manager UI.
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=10m

# --- Model manager (in-UI pull/remove/benchmark) ---
# Total RAM (GB) on the NAS, used to judge whether a model fits alongside the
# OS + SearXNG + backend. Defaults to 8 (UGREEN DXP2800).
NAS_RAM_GB=8
# RAM (GB) reserved for the OS + containers, subtracted from NAS_RAM_GB before
# comparing against a model's size + estimated KV cache. 1.5 is a safe default.
NAS_SYSTEM_RESERVE_GB=1.5

# CORS origin. Keep `*` while the browser extension is local-only/undistributed
# (the token is a genuine secret in that case). Before publishing the extension,
# pin this to the extension's origin, e.g. chrome-extension://<id>.
EXTENSION_ORIGIN=*

# --- Chat UI auth + history backend ---
# Secret used to sign session cookies. Generate with:  openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Brevo transactional email API key (for magic-link sign-in). Create a key at
# https://www.brevo.com and ensure MAIL_FROM is a Brevo-verified sender for
# selected.systems. If you use a different provider, see backend/email.go.
BREVO_API_KEY=

# Public base URL of the chat page (where magic-link emails link back to).
APP_BASE_URL=https://chat.selected.systems

# "From" address for magic-link emails. Must be a Brevo-verified sender.
MAIL_FROM=noreply@selected.systems

# Comma-separated allowlist of emails that may sign up. Empty = open sign-up.
# For a personal NAS, set this to your email, e.g.  ALLOWED_EMAILS=you@example.com
ALLOWED_EMAILS=

# --- Web search (Phase 10) ---
# Internal SearXNG endpoint used by the backend's web_search tool loop. Leave
# the default unless you change the `searxng` service. Set to empty to disable
# web search (the backend then falls back to a plain passthrough to Ollama).
SEARXNG_URL=http://searxng:8080
