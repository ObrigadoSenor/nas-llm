# ---------------------------------------------------------------------------
# nas-llm environment. Copy to .env and fill in. .env is gitignored.
#
# HOW A VARIABLE REACHES THE BACKEND CONTAINER
# Compose reads this file only to interpolate ${VAR} inside docker-compose.yml.
# A variable reaches the backend process ONLY if docker-compose.yml lists it
# under the `backend` service's `environment:` block. There is no `env_file:`.
#
# So: adding a variable here is only half the job. If the backend is meant to
# read it in production, it must also be added to that `environment:` block,
# with a default matching the one in the `config` struct in backend/main.go.
# ---------------------------------------------------------------------------

# NAS SSH access (used by scripts/deploy.sh and scripts/pull-models.sh).
NAS_HOST=192.168.1.50
NAS_USER=root

# Docker data volume on the NAS. Put model weights on the NVMe drive.
# Determine this in phase 1 by running `df -h` over SSH:
#   - /volume1  if the NVMe is folded into volume1
#   - /volume2  if the NVMe is its own volume
DOCKER_VOLUME=/volume1

# Cloudflare Tunnel token (phase 4). Leave blank until you create the named
# tunnel in the Cloudflare dashboard. deploy.sh only starts cloudflared when
# this is non-empty (via the `tunnel` compose profile).
TUNNEL_TOKEN=

# API bearer token. Generate with:  openssl rand -hex 32
# Use hex only — other characters can break the Caddyfile matcher.
API_BEARER_TOKEN=replace-with-openssl-rand-hex-32

# Model + tuning (phase 3).
OLLAMA_MODEL=llama3.2:3b
# Context length in tokens. The KV cache is what costs RAM and per-token time
# on 8 GB, so prefer a smaller context over a bigger model. 8192 is a good
# default for a 3B chat; docker-compose falls back to 16384 when this is unset,
# so keep it explicit here. Give the web_search 8B a shorter context (~8192)
# and keep the 3B at this value. This value is also read by the backend (via
# docker-compose) to estimate per-model KV-cache RAM in the model manager UI.
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=10m

# --- Model manager (in-UI pull/remove/benchmark) ---
# Total RAM (GB) on the NAS, used to judge whether a model fits alongside the
# OS + SearXNG + backend. Defaults to 8 (UGREEN DXP2800).
NAS_RAM_GB=8
# RAM (GB) reserved for the OS + containers, subtracted from NAS_RAM_GB before
# comparing against a model's size + estimated KV cache. 1.5 is a safe default.
NAS_SYSTEM_RESERVE_GB=1.5

# --- Optional remote Mac backend (bigger models) ---
# A second Ollama running on a Mac (or any machine with more RAM), reached over
# the LAN / Tailscale / an SSH tunnel. Leave OLLAMA_MAC_URL empty to disable it
# (NAS-only, the original single-host behavior). When set, the backend routes a
# model installed on the Mac to the Mac, and judges its fit against MAC_RAM_GB.
# NEVER publish the Mac's Ollama to the internet (no Cloudflare tunnel for it) —
# it is unauthenticated; keep it LAN/Tailscale/SSH only.
# Examples: http://100.64.x.y:11434 (Tailscale) or http://192.168.1.x:11434 (LAN)
OLLAMA_MAC_URL=
# Total RAM (GB) on the Mac, used to judge fit for Mac-hosted models. Set to
# the Mac's actual RAM; default 16 is just a placeholder.
MAC_RAM_GB=16
# RAM (GB) reserved for macOS + apps, subtracted before comparing. 2 is a start.
MAC_SYSTEM_RESERVE_GB=2

# CORS origin. Keep `*` while the browser extension is local-only/undistributed
# (the token is a genuine secret in that case). Before publishing the extension,
# pin this to the extension's origin, e.g. chrome-extension://<id>.
EXTENSION_ORIGIN=*

# --- Chat UI auth + history backend ---
# Secret used to sign session cookies. Generate with:  openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Brevo transactional email API key (for magic-link sign-in). Create a key at
# https://www.brevo.com and ensure MAIL_FROM is a Brevo-verified sender for
# selected.systems. If you use a different provider, see backend/email.go.
BREVO_API_KEY=

# Public base URL of the chat page (where magic-link emails link back to).
APP_BASE_URL=https://chat.selected.systems

# "From" address for magic-link emails. Must be a Brevo-verified sender.
MAIL_FROM=noreply@selected.systems

# Comma-separated allowlist of emails that may sign up. Empty = open sign-up.
# For a personal NAS, set this to your email, e.g.  ALLOWED_EMAILS=you@example.com
ALLOWED_EMAILS=

# --- Web search (Phase 10) ---
# Internal SearXNG endpoint used by the backend's web_search tool loop. Leave
# the default unless you change the `searxng` service. Set to empty to disable
# web search (the backend then falls back to a plain passthrough to Ollama).
SEARXNG_URL=http://searxng:8080
# Number of search rounds per web_search turn. More rounds give deeper answers
# on multi-part questions at the cost of latency. Default 1.
MAX_SEARCH_ROUNDS=1

# --- Clarifying questions (agent loop) ---
# Max back-to-back clarifying questions the model may ask per task before it
# must answer. Default 3. Needs a tool-capable model (e.g. qwen3:1.7b,
# qwen2.5:3b, llama3.1:8b); a non-tool model just answers directly.
MAX_CLARIFY_ROUNDS=3
# Offer the ask_user tool on every plain-chat turn for tool-capable models, not
# just under the Clarify toggle, so a clarifying question renders as a clickable
# card instead of plain text. Default on; set false to skip the tool-schema
# overhead on every turn (a question can still become a card via the detector).
ASK_USER_IN_PLAIN_CHAT=true
# Best-effort: detect a question the model wrote as prose ("Question: …?
# (e.g., A, B, C)") and render it as a clickable card — a fallback for small /
# non-tool models that don't call ask_user. Default on; set false to keep such
# turns as plain text.
CLARIFY_PROSE_DETECT=true

# --- Agent harness (Agent toggle in the + menu) ---
# Hard cap on tool-calling rounds per Agent-mode run. Small models loop on
# tools; the budget forces a final synthesized answer. A narration re-prompt
# round does not consume a step, and the model is warned at 80% of the budget
# to finish outstanding edits before synthesizing. Default 24 (was 6 — the old
# value truncated multi-file work mid-task).
MAX_AGENT_STEPS=24
# Enable the fetch_page tool (download a URL and read its text). OFF by default:
# it raises the prompt-injection surface — the model reads untrusted web
# content, which on a NAS holding personal data is the "lethal trifecta"
# (untrusted content + the agent's memory access + outbound comms). Set to
# 1/true/yes/on only if you accept that risk and want the agent to read pages.
FETCH_PAGE_ENABLED=false

# --- Concurrent chats (Phase 16) ---
# Size of the generation worker pool. A browser-relay (local-model) job blocks
# its worker while it awaits the user's browser, so with too few workers one
# local-model chat can stall every other chat in the queue. Server-side
# inference itself stays serialized per host regardless of this value (the NAS/
# Mac run Ollama with OLLAMA_NUM_PARALLEL=1); only browser-relay jobs actually
# run in parallel with each other. Default 4.
MAX_CONCURRENT_JOBS=4
# How long a browser-bound job (local inference, or a repo-bound agent run
# relaying file tools through the browser) is kept alive after its connection
# drops, waiting for a reattach — a chat switch or a page reload — before it is
# cancelled. Go duration syntax (e.g. 45s, 1m). Default 45s.
BROWSER_RELAY_GRACE=45s
# Timeout for a whole agent-mode generation. Longer than the 5m plain-chat
# timeout because apply_patch/run_command/git_commit/git_push/create_pr all
# block on a user approval dialog. Go duration syntax. Default 30m.
AGENT_JOB_TIMEOUT=30m
# Timeout for a single local file-tool relay round (the browser running a tool
# via the desktop sidecar and POSTing the observation back). Longer than a
# plain tool call for the same reason as AGENT_JOB_TIMEOUT: several of these
# tools wait on a user approval dialog. Go duration syntax. Default 15m.
TOOL_EXEC_TIMEOUT=15m
# Timeout for a single run_command the agent executes via the sidecar, so a
# non-exiting command (dev server, file watcher) can't park the relay until
# TOOL_EXEC_TIMEOUT. Carried on each toolExec payload; the sidecar kills the
# process and returns a timeout observation (exit 124) when it fires. Go
# duration syntax. Default 120s.
RUN_COMMAND_TIMEOUT=120s

# --- Local development only ---
# These three are supplied by docker-compose.yml in the deployed stack, so they
# do not belong in a production .env. Override them when running the backend
# directly outside Docker (see AGENTS.md, "Running it locally"):
#   BACKEND_PORT=8081                     # default 8081
#   DB_PATH=./dev.db                      # container default is /data/nas-llm.db
#   OLLAMA_URL=http://127.0.0.1:11434     # container default is http://ollama:11434
# `make run-backend` sets sane values for all three.
