{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nas-llm",
  "version": "0.1.0",
  "identifier": "com.selected.nasllm.desktop",
  "build": {
    "frontendDist": "../../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "nas-llm",
    "category": "DeveloperTool",
    "shortDescription": "Local-LLM codebase agent",
    "longDescription": "A Copilot-style desktop app that connects GitHub, clones repos, and runs a local agent against a codebase using local LLMs."
  }
}
